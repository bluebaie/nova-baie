# Private server configuration. No real credentials belong in this example.

# Contact form — direct SMTP delivery (Nodemailer). Gmail: an app password of the sending account.
SMTP_USER=
SMTP_PASS=
# Optional: another SMTP server (otherwise Gmail is used). 465 = TLS, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=
# Optional: recipient (default contact.novabaie@gmail.com) and sender address (default SMTP_USER).
CONTACT_TO_EMAIL=
EMAIL_FROM=

# Exact browser origins, comma separated, without a trailing slash.
CONTACT_ALLOWED_ORIGINS=https://www.nova-baie.com,https://nova-baie.com
# Rate limiting (3 per email / 15 min, 100 per hour): Upstash for Redis from the Vercel Marketplace
# (prefix CONTACT, region fra1) provides CONTACT_KV_REST_API_URL / CONTACT_KV_REST_API_TOKEN,
# used when the two variables below are empty. Missing limiter or SMTP disables delivery (503).
CONTACT_REDIS_REST_URL=
CONTACT_REDIS_REST_TOKEN=
# Generate at least 32 random characters; never expose this to the browser.
CONTACT_RATE_LIMIT_SECRET=
