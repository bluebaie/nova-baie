{
  "name": "nova-baie",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "packageManager": "npm@11.17.0",
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "15.5.29",
    "next-intl": "^4.9.2",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@next/swc-wasm-nodejs": "15.5.29",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.29",
    "ffmpeg-static": "^5.3.0",
    "lighthouse": "13.6.0",
    "postcss": "8.5.32",
    "tailwindcss": "^4.2.2",
    "tsx": "4.23.15",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "postcss": "$postcss",
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    }
  }
}
